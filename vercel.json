{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "installCommand": "npm install",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/monitoring/index",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/monitoring/health",            "destination": "/api/monitoring/index?action=health" },
    { "source": "/api/monitoring/daily-summary",     "destination": "/api/monitoring/index?action=daily-summary" },
    { "source": "/api/monitoring/publish-scheduled", "destination": "/api/monitoring/index?action=publish-scheduled" },
    { "source": "/api/monitoring/sentry-webhook",    "destination": "/api/monitoring/index?action=sentry-webhook" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}